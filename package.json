{
  "name": "voice-tower-cantonese-roguelike",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "粤语语音驱动的 Web 爬塔闯关 Roguelike（《声震龙楼》v2）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci . && tsc --noEmit && vitest run && vite build && vite-node scripts/perf-budget.ts",
    "sim": "vite-node scripts/balance-sim.ts",
    "perf": "vite build && vite-node scripts/perf-budget.ts",
    "test:e2e": "vite build && playwright test",
    "codegraph": "codegraph init --yes . || codegraph sync .",
    "codegraph:sync": "codegraph sync .",
    "codegraph:status": "codegraph status .",
    "sim:p7": "vite-node scripts/p7-balance.ts",
    "sim:p8": "vite-node scripts/p8-balance.ts",
    "sim:p8b": "vite-node scripts/p8b-balance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@colbymchenry/codegraph": "^1.6.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^12.8.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "pitchy": "^4.1.0"
  }
}
